<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net4.8</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <nullable>enable</nullable>
  </PropertyGroup>
  <Target Name="CopyDLL" AfterTargets="ILRepacker">
    <MakeDir Directories="$(ProjectDir)dist/plugins" />
    <Copy SourceFiles="$(TargetDir)$(ProjectName).dll" DestinationFolder="$(ProjectDir)dist/plugins" />
    <Message Text="Copied to dist/plugins." Importance="High" />
  </Target>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\libs-Tools\BepInEx.dll</HintPath>
    </Reference>
    <!-- The game's own netstandard 2.1 facade. Valheim's Unity 6 modules (ImageConversionModule and
         friends) are built against netstandard 2.1; net4.8 only supplies the 2.0 facade, so without this
         the build fails with CS1705 "uses netstandard 2.1.0.0 which has a higher version than referenced
         assembly netstandard 2.0.0.0". -->
    <Reference Include="netstandard">
      <HintPath>..\libs-Tools\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs-Tools\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs-Tools\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs-Tools\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\libs-Tools\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\libs-Tools\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>..\libs-Tools\UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\libs-Tools\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\libs-Tools\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\libs-Tools\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\libs-Tools\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs-Tools\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="gui_framework">
      <HintPath>..\libs-Tools\gui_framework.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\libs-Tools\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>..\libs-Tools\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\libs-Tools\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\libs-Tools\assembly_guiutils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>..\libs-Tools\SoftReferenceableAssets.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>..\libs-Tools\Splatform.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.1" PrivateAssets="all" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.6.1" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\BCAssets\AssetBundles\StandaloneWindows\bcassets" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Continents.BetterContinents" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Continents.png" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Pangaea.BetterContinents" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Pangaea.png" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Swirls.BetterContinents" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Swirls.png" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Vanillaish.BetterContinents" />
    <EmbeddedResource Include="assets\BCAssets\Presets\Vanillaish.png" />
  </ItemGroup>
</Project>
